# The platform workflows are off by default. Enable them only in an isolated
# Supabase-backed environment after setting all values below server-side.
SUPABASE_PLATFORM_WORKFLOWS_ENABLED=false

# Development-only Auth/MFA setup page at /platform/setup. This is a separate
# server-only kill switch. Keep it false in Netlify and all production
# environments. The project ref must match the hostname in SUPABASE_URL.
SUPABASE_AUTH_SETUP_ENABLED=false
SUPABASE_AUTH_SETUP_PROJECT_REF=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
